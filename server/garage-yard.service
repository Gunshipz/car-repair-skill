[Unit]
Description=Utah yard watch: Telegram when a watched car arrives (car-repair skill)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=USER
EnvironmentFile=/home/USER/garage/.env
ExecStart=/usr/bin/python3 -I /home/USER/garage/carkit/carkit.py yard watch /home/USER/garage/yard/watchlist.json /home/USER/garage/yard/state.json
